<resources>
    <style name="Theme.DeskPad" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="Theme.DeskPad.Fullscreen" parent="Theme.DeskPad">
        <item name="android:windowFullscreen">true</item>
