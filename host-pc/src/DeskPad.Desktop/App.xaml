<Application x:Class="DeskPad.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="DeskPad"
                            TrayMouseDoubleClick="OnTrayDoubleClick"
                            IconSource="/Assets/tray-icon.ico">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Kontrol Paneli" Click="OnShowControlPanel" />
                        <MenuItem Header="Çıkış" Click="OnExitApplication" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
